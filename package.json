{
  "name": "rachel8",
  "type": "module",
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "bun --watch run src/index.ts",
    "restart:delayed": "bun run scripts/restart.ts",
    "effort": "bun run scripts/effort.ts",
    "setup": "bun run src/setup/wizard.ts",
    "test": "bun test",
    "schedule": "bun run scripts/schedule.ts",
    "typecheck": "tsc --noEmit",
    "build": "bun build src/index.ts --target bun --outdir dist",
    "check": "bun run typecheck && bun test && bun run build"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.263",
    "@clack/prompts": "^1.7.0",
    "@openai/codex": "^0.153.4",
    "croner": "^10.0.1",
    "grammy": "^1.46.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/bun": "^1.4.1",
    "typescript": "^7.0.2"
  }
}
